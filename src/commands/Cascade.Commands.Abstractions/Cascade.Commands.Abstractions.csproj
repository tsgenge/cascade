<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Cascade.Commands</RootNamespace>
    <PackageId>Cascade.Commands.Abstractions</PackageId>
    <Description>Command abstractions for the Cascade Event Sourcing framework</Description>
  </PropertyGroup>
  
  <ItemGroup Condition="'$(UseProjectReferences)' == 'true'">
    <ProjectReference Include="..\..\shared\Cascade.SharedKernel.Abstractions\Cascade.SharedKernel.Abstractions.csproj" />
