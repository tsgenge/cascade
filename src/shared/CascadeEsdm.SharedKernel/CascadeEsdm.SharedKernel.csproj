<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>CascadeEsdm.SharedKernel</PackageId>
        <Description>Core implementation for the Cascade Event Sourcing framework</Description>
        <PackageIcon>icon.jpg</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="docs\README.md" Pack="true" PackagePath="\"/>
        <None Include="docs\icon.jpg" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup Condition="'$(UseProjectReferences)' == 'true'">
        <ProjectReference Include="..\CascadeEsdm.SharedKernel.Abstractions\CascadeEsdm.SharedKernel.Abstractions.csproj"/>
    </ItemGroup>

    <ItemGroup Condition="'$(UseProjectReferences)' != 'true'">
        <PackageReference Include="CascadeEsdm.SharedKernel.Abstractions" Version="$(CascadeVersion)"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="CascadeEsdm.WriteModel.Tests"/>
        <InternalsVisibleTo Include="CascadeEsdm.SharedKernel.UnitTests"/>
        <InternalsVisibleTo Include="DynamicProxyGenAssembly2"/>
    </ItemGroup>
</Project>
