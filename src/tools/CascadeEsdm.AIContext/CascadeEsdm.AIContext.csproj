<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>CascadeEsdm.AIContext</PackageId>
        <Description>AI agent context and best practices for projects using the Cascade ESDM framework. Installs a cascade-esdm.md rules file into .windsurf/rules/, .cursor/rules/, or AGENTS.md on first build.</Description>
        <PackageIcon>icon.jpg</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <NoPackageAnalysis>true</NoPackageAnalysis>
        <IncludeSymbols>false</IncludeSymbols>
    </PropertyGroup>

    <ItemGroup Condition="'$(UseProjectReferences)' == 'true'">
        <ProjectReference Include="..\..\shared\CascadeEsdm.SharedKernel.Abstractions\CascadeEsdm.SharedKernel.Abstractions.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseProjectReferences)' != 'true'">
        <PackageReference Include="CascadeEsdm.SharedKernel.Abstractions" Version="$(CascadeVersion)" />
    </ItemGroup>

    <ItemGroup>
        <None Include="build\CascadeEsdm.AIContext.props" Pack="true" PackagePath="build\" />
        <None Include="ai-context\cascade-esdm.md" Pack="true" PackagePath="ai-context\cascade-esdm.md" />
        <None Include="docs\README.md" Pack="true" PackagePath="\" />
        <None Include="docs\icon.jpg" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
