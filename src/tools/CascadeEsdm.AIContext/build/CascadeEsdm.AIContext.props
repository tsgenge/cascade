<Project>

  <Target Name="CascadeInstallAIContext" BeforeTargets="BeforeBuild">

    <!-- Locate repo root by walking up from the project directory to find .gitignore -->
    <PropertyGroup>
      <_CascadeRepoRoot>$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), '.gitignore'))</_CascadeRepoRoot>
      <_CascadeRootDir Condition="'$(_CascadeRepoRoot)' != ''">$(_CascadeRepoRoot)\</_CascadeRootDir>
      <_CascadeRootDir Condition="'$(_CascadeRootDir)' == ''">$(MSBuildProjectDirectory)\</_CascadeRootDir>
    </PropertyGroup>

    <Message Text="Cascade AIContext: Repo root='$(_CascadeRootDir)'" Importance="normal" />

    <!-- Define final paths -->
    <PropertyGroup>
      <_CascadeDevinDir>$(_CascadeRootDir).devin\</_CascadeDevinDir>
      <_CascadeWindsurfDir>$(_CascadeRootDir).windsurf\</_CascadeWindsurfDir>
      <_CascadeCursorDir>$(_CascadeRootDir).cursor\</_CascadeCursorDir>
      <_CascadeAgentsMdPath>$(_CascadeRootDir)AGENTS.md</_CascadeAgentsMdPath>
    </PropertyGroup>

    <!-- Check which directories actually exist -->
    <PropertyGroup>
      <_CascadeDevinExists Condition="Exists('$(_CascadeDevinDir)')">true</_CascadeDevinExists>
      <_CascadeWindsurfExists Condition="Exists('$(_CascadeWindsurfDir)')">true</_CascadeWindsurfExists>
      <_CascadeCursorExists Condition="Exists('$(_CascadeCursorDir)')">true</_CascadeCursorExists>
    </PropertyGroup>

    <Message Text="Cascade AIContext: Final check - .devin=$(_CascadeDevinExists), .windsurf=$(_CascadeWindsurfExists), .cursor=$(_CascadeCursorExists)" Importance="normal" />

    <!-- Collect all ai-context source files -->
    <ItemGroup>
      <_CascadeAIContextFiles Include="$(MSBuildThisFileDirectory)..\ai-context\**\*" />
    </ItemGroup>

    <!-- Copy to .devin/rules/ -->
    <MakeDir Directories="$(_CascadeDevinDir)rules\" Condition="'$(_CascadeDevinExists)' == 'true'" />
    <Copy
      SourceFiles="@(_CascadeAIContextFiles)"
      DestinationFolder="$(_CascadeDevinDir)rules\"
      SkipUnchangedFiles="true"
      Condition="'$(_CascadeDevinExists)' == 'true'" />
    <Message
      Text="Cascade ESDM: AI context rules written to .devin/rules/"
      Importance="high"
      Condition="'$(_CascadeDevinExists)' == 'true'" />

    <!-- Copy to .windsurf/rules/ -->
    <MakeDir Directories="$(_CascadeWindsurfDir)rules\" Condition="'$(_CascadeWindsurfExists)' == 'true'" />
    <Copy
      SourceFiles="@(_CascadeAIContextFiles)"
      DestinationFolder="$(_CascadeWindsurfDir)rules\"
      SkipUnchangedFiles="true"
      Condition="'$(_CascadeWindsurfExists)' == 'true'" />
    <Message
      Text="Cascade ESDM: AI context rules written to .windsurf/rules/"
      Importance="high"
      Condition="'$(_CascadeWindsurfExists)' == 'true'" />

    <!-- Copy to .cursor/rules/ -->
    <MakeDir Directories="$(_CascadeCursorDir)rules\" Condition="'$(_CascadeCursorExists)' == 'true'" />
    <Copy
      SourceFiles="@(_CascadeAIContextFiles)"
      DestinationFolder="$(_CascadeCursorDir)rules\"
      SkipUnchangedFiles="true"
      Condition="'$(_CascadeCursorExists)' == 'true'" />
    <Message
      Text="Cascade ESDM: AI context rules written to .cursor/rules/"
      Importance="high"
      Condition="'$(_CascadeCursorExists)' == 'true'" />

    <!-- Fallback: copy all files into the root, prefixed with cascade-esdm- -->
    <Copy
      SourceFiles="@(_CascadeAIContextFiles)"
      DestinationFolder="$(_CascadeRootDir)"
      SkipUnchangedFiles="true"
      Condition="'$(_CascadeDevinExists)' != 'true' AND '$(_CascadeWindsurfExists)' != 'true' AND '$(_CascadeCursorExists)' != 'true'" />
    <Message
      Text="Cascade ESDM: AI context written to repo root (no .devin, .windsurf or .cursor directory detected)"
      Importance="high"
      Condition="'$(_CascadeDevinExists)' != 'true' AND '$(_CascadeWindsurfExists)' != 'true' AND '$(_CascadeCursorExists)' != 'true'" />

  </Target>

</Project>
