<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Tool is net10.0 only; clear the multi-target list inherited from Directory.Build.props so pack does not build netstandard2.1. -->
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CascadeEsdm.EventExtractor</AssemblyName>
    <RootNamespace>CascadeEsdm.EventExtractor</RootNamespace>

    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cascade-extract-events</ToolCommandName>
    <PackageId>CascadeEsdm.EventExtractor</PackageId>
    <Description>Pre-build tool that extracts IDomainEvent records from a CascadeEsdm WriteModel project into a standalone, publishable Events assembly.</Description>
    <PackageTags>eventsourcing;ddd;cqrs;cascade;codegen</PackageTags>
    <PackageIcon>icon.jpg</PackageIcon>

    <!-- Inherit shared NuGet metadata from Directory.Build.props -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="docs\icon.jpg" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseProjectReferences)' == 'true'">
    <ProjectReference Include="..\..\shared\CascadeEsdm.SharedKernel\CascadeEsdm.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseProjectReferences)' != 'true'">
    <PackageReference Include="CascadeEsdm.SharedKernel" Version="$(CascadeVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CascadeEsdm.EventExtractor.Tests" />
  </ItemGroup>

</Project>
